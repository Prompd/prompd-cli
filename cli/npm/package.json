{
  "name": "@logikbug/prompd-cli",
  "version": "0.3.2",
  "description": "Node.js CLI for structured prompt definitions with universal LLM provider support",
  "main": "dist/index.js",
  "bin": {
    "prompd": "./bin/prompd.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "prompts",
    "cli",
    "openai",
    "anthropic",
    "ollama",
    "prompt-engineering"
  ],
  "author": "Logikbug",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "yaml": "^2.3.4",
    "js-yaml": "^4.1.0",
    "archiver": "^6.0.1",
    "chalk": "^4.1.2",
    "fs-extra": "^11.2.0",
    "axios": "^1.6.2",
    "inquirer": "^9.2.12",
    "glob": "^10.3.10",
    "semver": "^7.5.4",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "tar": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.8",
    "@types/semver": "^7.5.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/tar": "^6.1.11",
    "@types/js-yaml": "^4.0.9",
    "@types/archiver": "^6.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}