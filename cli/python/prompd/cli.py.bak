@cli.group()
def package():
    """Package management commands."""
    pass


@package.command('create')
@click.argument('source', type=click.Path(exists=True, path_type=Path))
@click.argument('output_path', type=click.Path(path_type=Path), required=False)
@click.option('--name', help='Package name (overrides .pdproj)')
@click.option('--version', help='Package version (overrides .pdproj)')
@click.option('--description', help='Package description (overrides .pdproj)')
@click.option('--author', help='Package author (overrides .pdproj)')
def package_create(source: Path, output_path: Optional[Path], name: Optional[str], version: Optional[str], description: Optional[str], author: Optional[str]):
    """Create a .pdpkg package from a directory or .pdproj file."""
    try:
        # Check if source is a .pdproj file
        if source.suffix == '.pdproj':
            # Parse .pdproj file as YAML (no frontmatter in .pdproj files)
            import yaml
            with open(source, 'r', encoding='utf-8') as f:
                pdproj_content = f.read()
            
            # Parse as YAML (comment-style format)
            pdproj_data = yaml.safe_load(pdproj_content)
            
            # Extract metadata from .pdproj
            proj_name = name or pdproj_data.get('name', source.stem)
            proj_version = version or pdproj_data.get('version', '1.0.0')
            proj_description = description or pdproj_data.get('description', 'Package created from .pdproj')
            proj_author = author or pdproj_data.get('author', 'unknown')
            
            # Source directory is parent of .pdproj file
            source_dir = source.parent
            
            # Default output path based on project name and version
            if not output_path:
                output_path = source.parent / f"{proj_name.lower().replace(' ', '-')}-v{proj_version}.pdpkg"
            
        else:
            # Legacy directory mode - require manual parameters
            if not all([name, version, description]):
                console.print("[red]ERROR[/red] When packaging a directory, --name, --version, and --description are required")
                sys.exit(1)
            
            source_dir = source
            proj_name = name
            proj_version = version
            proj_description = description
            proj_author = author
            
            # Default output path
            if not output_path:
                output_path = source_dir / f"{proj_name}-v{proj_version}.pdpkg"
        
        # Ensure output has .pdpkg extension
        if not output_path.suffix:
            output_path = output_path.with_suffix('.pdpkg')
        elif output_path.suffix != '.pdpkg':
            output_path = output_path.with_suffix('.pdpkg')
        
        # Create manifest
        manifest = {
            'name': proj_name,
            'version': proj_version,
            'description': proj_description,
            'type': 'package'
        }
        
        if proj_author:
            manifest['author'] = proj_author
        
        # Find .prompd and .pdflow files
        prompd_files = list(source_dir.glob('**/*.prompd'))
        pdflow_files = list(source_dir.glob('**/*.pdflow'))
        
        if prompd_files:
            manifest['files'] = {'prompts': [str(f.relative_to(source_dir)) for f in prompd_files]}
        
        if pdflow_files:
            if 'files' not in manifest:
                manifest['files'] = {}
            manifest['files']['workflows'] = [str(f.relative_to(source_dir)) for f in pdflow_files]
        
        # Create package
        create_pdpkg(source_dir, output_path, manifest)
        
        console.print(f"[bold green]Package created successfully![/bold green]")
        console.print(f"   Package: [cyan]{output_path}[/cyan]")
        console.print(f"   Size: {output_path.stat().st_size / 1024:.1f} KB")
        
        # Validate the created package
        validate_pdpkg(output_path)
        console.print("[green]Package validation passed[/green]")
        
    except Exception as e:
        console.print(f"[bold red]Package creation failed:[/bold red] {e}")
        sys.exit(1)


@package.command('validate')
@click.argument('package_path', type=click.Path(exists=True, path_type=Path))
def package_validate(package_path: Path):
    """Validate a .pdpkg package archive."""
    try:
        # Check file extension - only accept package archives
        if not package_path.name.endswith('.pdpkg'):
            console.print(f"[red]ERROR[/red] [bold red]Invalid package format![/bold red]")
            console.print(f"   File: {package_path.name}")
            console.print("   Expected: .pdpkg archive file")
            console.print("   Note: .prompd files are individual prompts, not packages")
            console.print("   Use 'prompd validate' to validate individual .prompd files")
            sys.exit(1)
        
        console.print(f"[blue]INFO[/blue] Validating package: [cyan]{package_path.name}[/cyan]")
        
        result = validate_package(package_path)
        
        if result.is_valid:
            console.print("[green]SUCCESS[/green] [bold green]Package validation passed![/bold green]")
            
            # Show package info if available
            if result.package_info:
                info = result.package_info
                console.print(f"   Package: [cyan]{info.get('name', 'unknown')}[/cyan]")
                console.print(f"   Version: [green]{info.get('version', 'unknown')}[/green]")
                console.print(f"   Description: {info.get('description', 'No description')}")
                
                if 'parameters' in info:
                    console.print(f"   Parameters: {len(info['parameters'])}")
        else:
            console.print("[red]ERROR[/red] [bold red]Package validation failed![/bold red]")
            
            for error in result.errors:
                console.print(f"   - [red]{error}[/red]")
        
        # Show warnings if any
        if result.warnings:
            console.print("\n[yellow]WARNINGS:[/yellow]")
            for warning in result.warnings:
                console.print(f"   - [yellow]{warning}[/yellow]")
        
        if not result.is_valid:
            sys.exit(1)
        
    except Exception as e:
        console.print(f"[red]ERROR[/red] [bold red]Validation failed:[/bold red] {e}")
        sys.exit(1)




@cli.command()
@click.argument('file_path', type=click.Path(exists=True, path_type=Path))
@click.option('-p', '--param', multiple=True, help='Parameter in format key=value')
@click.option('--param-file', type=click.Path(exists=True, path_type=Path), help='JSON parameter file')
@click.option('-o', '--output', type=click.Path(path_type=Path), help='Output file path')
def render(file_path: Path, param: tuple, param_file: Optional[Path], output: Optional[Path]):
    """Render a .prompd file with parameters - returns compiled prompt text."""
    try:
        # Parse the .prompd file
        parser = PrompdParser()
        prompd = parser.parse_file(str(file_path))
        
        # Collect parameters from different sources
        parameters = {}
        
        # Load from parameter file if provided
        if param_file:
            import json
            with open(param_file, 'r') as f:
                file_params = json.load(f)
                parameters.update(file_params)
        
        # Parse command line parameters
        for p in param:
            if '=' not in p:
                console.print(f"[red]ERROR[/red] Invalid parameter format: {p}")
                console.print("Use format: --param key=value")
                sys.exit(1)
            
            key, value = p.split('=', 1)
            # Handle different value types
            if value.lower() == 'true':
                value = True
            elif value.lower() == 'false':
                value = False
            elif value.isdigit():
                value = int(value)
            elif value.replace('.', '').isdigit():
                value = float(value)
            # Remove quotes if present
            elif value.startswith('"') and value.endswith('"'):
                value = value[1:-1]
            elif value.startswith("'") and value.endswith("'"):
                value = value[1:-1]
            
            parameters[key] = value
        
        # Validate required parameters are provided
        required_params = {p.name for p in prompd.metadata.parameters if p.required}
        provided_params = set(parameters.keys())
        missing_params = required_params - provided_params
        
        if missing_params:
            console.print(f"[red]ERROR[/red] Missing required parameters: {', '.join(missing_params)}")
            sys.exit(1)
        
        # Add default values for optional parameters
        for param in prompd.metadata.parameters:
            if param.name not in parameters and hasattr(param, 'default') and param.default is not None:
                parameters[param.name] = param.default
        
        # Render the template
        from jinja2 import Template, Environment
        import re
        
        # Convert {variable} syntax to {{ variable }} for Jinja2
        template_content = prompd.content
        template_content = re.sub(r'\{([^}]+)\}', r'{{ \1 }}', template_content)
        
        # Create Jinja environment for template rendering
        env = Environment()
        template = env.from_string(template_content)
        
        # Render with parameters
        rendered_content = template.render(**parameters)
        
        # Output results
        if output:
            with open(output, 'w', encoding='utf-8') as f:
                f.write(rendered_content)
            console.print(f"[green]SUCCESS[/green] Rendered prompt saved to: [cyan]{output}[/cyan]")
        else:
            # Just print the compiled prompt
            print(rendered_content.strip())
        
    except Exception as e:
        console.print(f"[red]ERROR[/red] Render failed: {e}")
        sys.exit(1)


@cli.command(context_settings={"ignore_unknown_options": True, "allow_extra_args": True})
@click.argument("file", type=click.Path(exists=True, path_type=Path))
@click.option("--provider", required=True, help="LLM provider (openai, anthropic, ollama)")
@click.option("--model", required=True, help="Model name")
@click.option("--param", "-p", multiple=True, help="Parameter in format key=value")
@click.option("--param-file", "-f", type=click.Path(exists=True, path_type=Path), 
              multiple=True, help="JSON parameter file")
@click.option("--api-key", help="API key override")
@click.option("--output", "-o", type=click.Path(), help="Output file path")
@click.option("--format", type=click.Choice(["text", "json"]), default="text", help="Output format")
@click.option("--version", help="Run a specific version (e.g., '1.2.3', 'HEAD', commit hash)")
@click.option("--meta-system", help="Override system section (text or file path like ./file.txt)")
@click.option("--meta-context", help="Override context section (text or file path like ./file.txt)")
@click.option("--meta-user", help="Override user section (text or file path like ./file.txt)")
@click.option("--verbose", "-v", is_flag=True, help="Verbose output")
@click.option("--show-usage", is_flag=True, help="Show token usage statistics")
@click.pass_context
def run(ctx, file: Path, provider: str, model: str, param: tuple, param_file: tuple, 
        api_key: Optional[str], output: Optional[str], format: str, version: Optional[str], 
        meta_system: Optional[str], meta_context: Optional[str], meta_user: Optional[str],
        verbose: bool, show_usage: bool):
    """Run a .prompd file with an LLM provider."""
    import asyncio
    import tempfile
    import subprocess

    try:
        # Handle version checkout if specified
        actual_file = file
        temp_file = None
        
        if version:
            with tempfile.NamedTemporaryFile(mode='w', suffix='.prompd', delete=False, encoding='utf-8') as tmp:
                temp_file = Path(tmp.name)
                
                if _is_valid_semver(version):
                    tag_name = f"{file.stem}-v{version}"
                    tag_check = subprocess.run(
                        ["git", "tag", "-l", tag_name],
                        capture_output=True,
                        text=True
                    )
                    version_ref = tag_name if tag_check.stdout.strip() else version
                else:
                    version_ref = version
                
                git_path = str(file).replace('\', '/')
                result = subprocess.run(
                    ["git", "show", f"{version_ref}:{git_path}"],
                    capture_output=True,
                    text=True,
                    check=True
                )
                
                tmp.write(result.stdout)
                actual_file = temp_file
                
                if verbose:
                    console.print(f"[dim]Using version {version} of {file}[/dim]")
        
        # Create executor
        executor = PrompDExecutor()
        
        # Convert parameters
        cli_params = list(param) if param else None
        param_files = [Path(p) for p in param_file] if param_file else None
        
        # Process metadata overrides (full replace)
        metadata_overrides: Dict[str, str] = {}
        for key, value in [("system", meta_system), ("context", meta_context), ("user", meta_user)]:
            if value:
                if value.startswith('./') or value.startswith('/') or (len(value) > 1 and value[1] == ':'):
                    try:
                        file_path = Path(value)
                        if not file_path.is_absolute():
                            file_path = actual_file.parent / file_path
                        metadata_overrides[key] = file_path.read_text(encoding='utf-8')
                        if verbose:
                            console.print(f"[dim]Loaded {key} from {file_path}[/dim]")
                    except Exception as e:
                        console.print(f"[red]Error reading {key} file '{value}': {e}[/red]")
                        sys.exit(1)
                else:
                    metadata_overrides[key] = value
        
        # Dynamic --meta:section appends (repeatable)
        def _normalize_section(name: str):
            k = name.lower().strip()
            if k in ("system", "context", "user", "response"):
                return k
            if k in ("task", "instruction", "prompt", "request"):
                return "user"
            if k in ("background",):
                return "context"
            if k in ("output", "schema"):
                return "response"
            return None
        
        def _resolve_meta_path(path_str: str) -> Path:
            # Support package refs: @scope/name@ver/inner/path
            if path_str.startswith('@') and '/' in path_str:
                pkg_ref, _, inner = path_str.partition('/')
                from prompd.package_resolver import package_resolver
                pkg_dir = package_resolver.resolve_package(pkg_ref)
                return Path(pkg_dir) / inner
            p = Path(path_str)
            return p if p.is_absolute() else (actual_file.parent / p)
        
        def _append(section: str, text: str):
            norm = _normalize_section(section)
            header = f"## {section.capitalize()} from meta\n\n"
            if norm:
                existing = metadata_overrides.get(norm, "")
                metadata_overrides[norm] = (existing.rstrip() + "\n\n" + header + text) if existing else (header + text)
            else:
                labeled = f"## {section} (Appended)\n\n{text}"
                existing = metadata_overrides.get("context", "")
                metadata_overrides["context"] = (existing.rstrip() + "\n\n" + labeled) if existing else labeled
        
        # Parse ctx.args for flags of the form --meta:section[=]path
        for i, tok in enumerate(list(ctx.args)):
            if not isinstance(tok, str):
                continue
            if tok == '--meta':
                raise click.UsageError("Use --meta:section <file> (with colon)")
            if tok.startswith('--meta:'):
                section_part = tok[len('--meta:'):]
                if '=' in section_part:
                    section, path_str = section_part.split('=', 1)
                else:
                    if i + 1 >= len(ctx.args) or str(ctx.args[i+1]).startswith('-'):
                        raise click.UsageError(f"Missing file after {tok}")
                    section = section_part
                    path_str = ctx.args[i+1]
                meta_path = _resolve_meta_path(path_str)
                try:
                    text = meta_path.read_text(encoding='utf-8')
                except Exception as e:
                    console.print(f"[red]Error reading meta file '{meta_path}':[/red] {e}")
                    sys.exit(1)
                _append(section, text)
        
        # Execute
        response = asyncio.run(executor.execute(
            prompd_file=actual_file,
            provider=provider,
            model=model,
            cli_params=cli_params,
            param_files=param_files,
            api_key=api_key,
            metadata_overrides=metadata_overrides if metadata_overrides else None
        ))
        
        # Clean up temp file if created
        if temp_file and temp_file.exists():
            temp_file.unlink()
        
        # Output result based on format
        if format == "json":
            result = {
                "response": response.content,
                "provider": provider,
                "model": model,
                "file": str(file)
            }
            if response.usage:
                result["usage"] = response.usage
            
            json_output = json.dumps(result, indent=2, ensure_ascii=False)
            
            if output:
                with open(output, "w", encoding="utf-8") as f:
                    f.write(json_output)
                try:
                    console.print(f"[green]OK[/green] JSON response written to {output}")
                except UnicodeEncodeError:
                    print(f"OK - JSON response written to {output}")
            else:
                print(json_output)
        else:
            # Text format (default)
            if output:
                with open(output, "w", encoding="utf-8") as f:
                    f.write(response.content)
                try:
                    console.print(f"[green]OK[/green] Response written to {output}")
                except UnicodeEncodeError:
                    print(f"OK - Response written to {output}")
            else:
                try:
                    console.print(Panel(
                        response.content, 
                        title=f"Response from {provider}/{model}",
                        border_style="green"
                    ))
                except UnicodeEncodeError:
                    print(f"
--- Response from {provider}/{model} ---")
                    print(response.content)
                    print("-" * 50)
                
                if (verbose or show_usage) and response.usage:
                    try:
                        console.print(f"
[dim]Usage: {response.usage}[/dim]")
                    except UnicodeEncodeError:
                        print(f"
Usage: {response.usage}")
            
    except ConfigurationError as e:
        try:
            console.print(f"[red]Configuration Error:[/red] {e}")
        except UnicodeEncodeError:
            print(f"Configuration Error: {e}")
        sys.exit(1)
    except ProviderError as e:
        try:
            console.print(f"[red]Provider Error:[/red] {e}")
        except UnicodeEncodeError:
            print(f"Provider Error: {e}")
        sys.exit(1)
    except PrompDError as e:
        try:
            console.print(f"[red]Error:[/red] {e}")
        except UnicodeEncodeError:
            print(f"Error: {e}")
        sys.exit(1)
    except Exception as e:
        try:
            console.print(f"[red]Unexpected error:[/red] {e}")
            if verbose:
                import traceback
                console.print(traceback.format_exc())
        except UnicodeEncodeError:
            print(f"Unexpected error: {e}")
            if verbose:
                import traceback
                print(traceback.format_exc())
        sys.exit(1)



@cli.command()
@click.argument("file")
@click.option("--param", "-p", multiple=True, help="Parameter in format key=value")
@click.option("--param-file", "-f", type=click.Path(exists=True, path_type=Path), 
              multiple=True, help="JSON parameter file")
@click.option("--output", "-o", type=click.Path(), help="Output file path")
@click.option("--to-markdown", "output_format", flag_value="markdown", 
              help="Compile to human-readable markdown (default)")
@click.option("--to-provider-json", help="Compile to provider JSON format (openai, anthropic, google)")
@click.option("--verbose", "-v", is_flag=True, help="Verbose output")
def compile(file: str, param: tuple, param_file: tuple, output: Optional[Path], 
            output_format: str, to_provider_json: Optional[str], verbose: bool):
    """
    Compile a .prompd file to various output formats.
    
    FILE: Path to .prompd file or package reference (e.g., @security/audit@2.0.0)
    """
    try:
        # Initialize compiler
        compiler = PrompdCompiler()
        
        # Parse parameters
        parameters = {}
        if param:
            for p in param:
                if '=' in p:
                    key, value = p.split('=', 1)
                    parameters[key] = value
                else:
                    console.print(f"[red]ERROR[/red] Invalid parameter format: {p} (should be key=value)")
                    sys.exit(1)
        
        # Load parameter files
        if param_file:
            for pf in param_file:
                try:
                    with open(pf, 'r', encoding='utf-8') as f:
                        file_params = json.load(f)
                        parameters.update(file_params)
                except Exception as e:
                    console.print(f"[red]ERROR[/red] Failed to load parameter file {pf}: {e}")
                    sys.exit(1)
        
        # Determine output format
        if to_provider_json:
            if to_provider_json in ["openai", "anthropic", "google"]:
                format_name = f"provider-json:{to_provider_json}"
            else:
                console.print(f"[red]ERROR[/red] Unsupported provider: {to_provider_json}")
                console.print("Supported providers: openai, anthropic, google")
                sys.exit(1)
        else:
            format_name = output_format or "markdown"
        
        if verbose:
            console.print(f"[dim]Compiling {file} to {format_name} format...[/dim]")
        
        # Compile the file
        result = compiler.compile(
            source=file,
            output_format=format_name,
            parameters=parameters,
            output_file=output
        )
        
        # Output result
        if output:
            console.print(f"[green]SUCCESS[/green] Compiled output saved to: [cyan]{output}[/cyan]")
        else:
            if format_name.startswith("provider-json"):
                # Pretty print JSON
                import json
                parsed = json.loads(result)
                print(json.dumps(parsed, indent=2))
            else:
                print(result)
        
        if verbose:
            console.print(f"[dim]Compilation completed successfully[/dim]")
        
    except Exception as e:
        console.print(f"[red]ERROR[/red] Compilation failed: {e}")
        if verbose:
            import traceback
            traceback.print_exc()
        sys.exit(1)


@cli.group()
def cache():
    """Package cache management commands."""
    pass


@cache.command("list")
def cache_list():
    """List cached packages."""
    try:
        cached_packages = package_resolver.list_cached_packages()
        
        if not cached_packages:
            console.print("[yellow]No packages cached[/yellow]")
            return
        
        # Create table
        table = Table(title="Cached Packages")
        table.add_column("Package", style="cyan")
        table.add_column("Version", style="green")
        table.add_column("Path", style="dim")
        
        for pkg in cached_packages:
            manifest = pkg['manifest']
            name = manifest.get('name', 'Unknown')
            version = manifest.get('version', 'Unknown')
            path = str(pkg['path'])
            table.add_row(name, version, path)
        
        console.print(table)
        
    except Exception as e:
        console.print(f"[red]ERROR[/red] Failed to list cache: {e}")
        sys.exit(1)


@cache.command("clear")
@click.option("--yes", "-y", is_flag=True, help="Skip confirmation prompt")
def cache_clear(yes: bool):
    """Clear the package cache."""
    try:
        if not yes:
            cached_packages = package_resolver.list_cached_packages()
            count = len(cached_packages)
            
            if count == 0:
                console.print("[yellow]Cache is already empty[/yellow]")
                return
            
            if not click.confirm(f"Clear {count} cached packages?"):
                console.print("Cancelled.")
                return
        
        package_resolver.clear_cache()
        console.print("[green]SUCCESS[/green] Package cache cleared")
        
    except Exception as e:
        console.print(f"[red]ERROR[/red] Failed to clear cache: {e}")
        sys.exit(1)


@cache.command("info")
def cache_info():
    """Show cache information."""
    try:
        cache_dir = package_resolver.cache.cache_dir
        cached_packages = package_resolver.list_cached_packages()
        
        console.print(Panel(
            f"[bold cyan]Package Cache Information[/bold cyan]\n\n"
            f"[bold]Cache Directory:[/bold] {cache_dir}\n"
            f"[bold]Cached Packages:[/bold] {len(cached_packages)}\n"
            f"[bold]Registry URLs:[/bold] {', '.join(package_resolver.registry_urls)}",
            border_style="blue"
        ))
        
    except Exception as e:
        console.print(f"[red]ERROR[/red] Failed to get cache info: {e}")
        sys.exit(1)


@cli.command("shell")
def shell():
    """Start Prompd shell with conversational AI assistant and rich CLI experience."""
    try:
        from .shell import start_prompd_shell
        start_prompd_shell()
    except ImportError as e:
        # Fallback to simple interactive mode if enhanced shell is not available
        try:
            start_simple_interactive()
        except ImportError as fallback_e:
            console.print(f"[red]ERROR[/red] Shell mode requires additional dependencies: {fallback_e}")
            console.print("[yellow]Install with:[/yellow] pip install prompd[interactive]")
            sys.exit(1)
    except Exception as e:
        console.print(f"[red]ERROR[/red] Shell mode failed: {e}")
        sys.exit(1)


 


@registry.command("list")
def registry_list():
    """List all configured registries."""
    try:
        config = PrompDConfig.load()
        registries = config.registry.get('registries', {})
        default_registry = config.registry.get('default')
        
        if not registries:
            console.print("[yellow]No registries configured[/yellow]")
            console.print("[dim]Use 'prompd registry add' to add a registry[/dim]")
            return
        
        console.print("[bold]Configured Registries:[/bold]")
        for name, registry_config in registries.items():
            default_mark = " [green](default)[/green]" if name == default_registry else ""
            url = registry_config.get('url', 'N/A')
            username = registry_config.get('username', 'Not logged in')
            console.print(f"  • [cyan]{name}[/cyan]{default_mark}")
            console.print(f"    URL: {url}")
            console.print(f"    User: {username}")
            
    except Exception as e:
        console.print(f"[red]Error listing registries:[/red] {e}")
        sys.exit(1)


@registry.command("add")
@click.argument('name')
@click.argument('url')
def registry_add(name: str, url: str):
    """Add a new registry."""
    try:
        config = PrompDConfig.load()
        
        if 'registries' not in config.registry:
            config.registry['registries'] = {}
        
        config.registry['registries'][name] = {
            'url': url,
            'token': None,
            'username': None
        }
        
        # Set as default if it's the first registry
        if 'default' not in config.registry:
            config.registry['default'] = name
            
        config.save()
        console.print(f"[green]Added registry '[cyan]{name}[/cyan]' at {url}[/green]")
        
    except Exception as e:
        console.print(f"[red]Error adding registry:[/red] {e}")
        sys.exit(1)


@registry.command("remove")
@click.argument('name')
@click.option('--force', is_flag=True, help='Force removal of default prompdhub registry')
def registry_remove(name: str, force: bool):
    """Remove a registry."""
    try:
        config = PrompDConfig.load()
        
        if 'registries' not in config.registry or name not in config.registry['registries']:
            console.print(f"[red]Registry '{name}' not found[/red]")
            sys.exit(1)
        
        # Warn about removing prompdhub unless forced
        if name == 'prompdhub' and not force:
            console.print("[yellow]Warning:[/yellow] Removing the main prompdhub registry")
            console.print("Use --force to confirm, or consider setting a different default instead")
            sys.exit(1)
            
        del config.registry['registries'][name]
        
        # Update default if we removed the default registry
        if config.registry.get('default') == name:
            remaining = list(config.registry['registries'].keys())
            config.registry['default'] = remaining[0] if remaining else None
            
        config.save()
        console.print(f"[green]Removed registry '[cyan]{name}[/cyan]'[/green]")
        
    except Exception as e:
        console.print(f"[red]Error removing registry:[/red] {e}")
        sys.exit(1)


@registry.command("set-default")
@click.argument('name')
def registry_set_default(name: str):
    """Set the default registry."""
    try:
        config = PrompDConfig.load()
        
        if 'registries' not in config.registry or name not in config.registry['registries']:
            console.print(f"[red]Registry '{name}' not found[/red]")
            console.print("Use 'prompd registry list' to see available registries")
            sys.exit(1)
            
        config.registry['default'] = name
        config.save()
        console.print(f"[green]Set '[cyan]{name}[/cyan]' as default registry[/green]")
        
    except Exception as e:
        console.print(f"[red]Error setting default registry:[/red] {e}")
        sys.exit(1)


def main():
    """Main entry point."""
    cli()


if __name__ == "__main__":
    main()
