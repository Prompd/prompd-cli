{
  "name": "prompd",
  "displayName": "Prompd",
  "description": "Language support for Prompd (.prompd) files - structured prompt definitions for LLMs",
  "version": "0.1.0",
  "publisher": "logikbug",
  "icon": "icons/prompd-icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Other"
  ],
  "keywords": [
    "prompd",
    "prompt",
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gpt",
    "claude"
  ],
  "activationEvents": [
    "onLanguage:prompd",
    "workspaceContains:**/*.prompd",
    "onCommand:prompd.execute",
    "onCommand:prompd.validate"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "prompd",
        "aliases": ["Prompd", "prompd", "PMD"],
        "extensions": [".prompd"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/prompd-icon.svg",
          "dark": "./icons/prompd-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "prompd",
        "scopeName": "source.prompd",
        "path": "./syntaxes/prompd.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "prompd.execute",
        "title": "Execute Prompd File",
        "category": "Prompd",
        "icon": "$(play)"
      },
      {
        "command": "prompd.validate",
        "title": "Validate Prompd File",
        "category": "Prompd",
        "icon": "$(check)"
      },
      {
        "command": "prompd.bumpVersion",
        "title": "Bump Version",
        "category": "Prompd",
        "icon": "$(tag)"
      },
      {
        "command": "prompd.preview",
        "title": "Preview Rendered Prompt",
        "category": "Prompd",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .prompd",
          "command": "prompd.execute",
          "group": "navigation@1"
        },
        {
          "when": "resourceExtname == .prompd",
          "command": "prompd.validate",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname == .prompd",
          "command": "prompd.execute",
          "group": "prompd@1"
        },
        {
          "when": "resourceExtname == .prompd",
          "command": "prompd.validate",
          "group": "prompd@2"
        }
      ]
    },
    "snippets": [
      {
        "language": "prompd",
        "path": "./snippets/prompd.json"
      }
    ],
    "configuration": {
      "title": "Prompd",
      "properties": {
        "prompd.defaultProvider": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "anthropic", "ollama"],
          "description": "Default LLM provider for executing prompts"
        },
        "prompd.defaultModel": {
          "type": "string",
          "default": "gpt-4",
          "description": "Default model for executing prompts"
        },
        "prompd.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate .prompd files on save"
        },
        "prompd.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inline execution buttons above prompts"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.3"
  },
  "dependencies": {
    "yaml": "^2.3.0"
  }
}